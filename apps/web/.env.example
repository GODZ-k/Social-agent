# Clerk (https://dashboard.clerk.com -> API keys).
# Leave these unset in development and Clerk runs in keyless mode with temporary keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Development shortcut: comma-separated emails treated as admins by the UI.
# In production, set { "role": "admin" } in the user's public metadata in Clerk instead.
NEXT_PUBLIC_ADMIN_EMAILS=

# Base URL of apps/api.
NEXT_PUBLIC_API_URL=http://localhost:4000
