{
  "name": "@social-agent/social-connect",
  "version": "0.1.0",
  "description": "Connect social media accounts for publishing: authorize URL, code exchange, token refresh and profile per network. No framework, no storage.",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch --preserveWatchOutput",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "typescript": "7.0.2"
  }
}
